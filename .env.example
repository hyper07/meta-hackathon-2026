# Watch Me settings. Copy this file to .env in the repo root and fill in what you have:
#
#   cp -n .env.example .env
#
# .env is git-ignored; never commit it. Everything is optional: without keys the app runs
# with the phrase list, the fixed rules and dry-run alerts (shown on screen and in the log).
# An app/.env, if there is one, overrides this file.

# ── Meta Model API ───────────────────────────────────────────────────────────────────────
# Every model agent runs on it: Muse Spark is the Analyst, the Decider and the alert writer,
# Muse Wonder reviews Notice accounts, Muse Voice Transcribe turns speech into text.
# Get a key at https://dev.meta.ai. META_API_KEY also works.
MODEL_API_KEY=
# MODEL_API_BASE_URL=https://api.meta.ai/v1
# MODEL_API_MODEL=muse-spark-1.3       # the default for every agent below that isn't set
# ANALYST_MODEL=muse-spark-1.3         # live: scores what was heard ("open" by default when BASETEN_API_KEY is set)
# DECIDER_MODEL=muse-spark-1.1         # discard, ask "Are you OK?", or alert ("open" by default when BASETEN_API_KEY is set)
# REVIEWER_MODEL=muse-wonder-1.0       # Notice: which words match the EEOC's descriptions
# WRITER_MODEL=muse-spark-1.3          # alert texts and session summaries
# LLM_REASONING_EFFORT=low             # higher efforts can use the whole token budget

# ── Muse Spark Open, the open-weight backup ─────────────────────────────────────────────
# When a Meta Model API call fails, the same request goes to Muse Spark Open before the fixed rules
# take over. With this key, Muse Spark Open runs the live Analyst, Decider and writer, and the hosted
# models become their backup. Served by Baseten Model APIs by default; any OpenAI-compatible endpoint serving it works
# (a Modal shared endpoint: OPEN_WEIGHTS_BASE=https://inference.us-west.modal.direct/v1, OPEN_WEIGHTS_MODEL=
# <its hostname>, MODAL_PROXY_TOKEN=<id>.<secret>). Set an agent's model to "open" to run it there directly.
BASETEN_API_KEY=
# OPEN_WEIGHTS_BASE=https://inference.baseten.co/v1
# OPEN_WEIGHTS_MODEL=meta-models/muse-spark-open

# ── Alerts: SMS and voice calls (Twilio) ─────────────────────────────────────────────────
# TWILIO_FROM is your Twilio number, like +12125550123. Without these, alerts are a dry run.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Alerts: email ────────────────────────────────────────────────────────────────────────
# For Gmail: smtp.gmail.com, port 587, and an app password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM=                           # defaults to SMTP_USER

# ── Listening ────────────────────────────────────────────────────────────────────────────
# STT_ENGINE=whisper                   # live 4 s chunks: whisper (this machine) | muse (Muse Voice Transcribe, Whisper as fallback)
# ANALYST_STT=muse                     # the last minute, re-transcribed by Muse Voice Transcribe before each analysis | whisper
# STT_TIMEOUT=6                        # with STT_ENGINE=muse: seconds to wait before Whisper takes the chunk
# WHISPER_MODEL=base                   # tiny | base | small; bigger is slower and more accurate
# WHISPER_LANGUAGE=en                  # empty = detect
# VOICE_THRESHOLD=0.20                 # voiceprint match needed to start ("Watch me")
# VOICE_STRICT_THRESHOLD=0.36          # ...and to stop or say "I'm OK"
# RECORDING_RULE=one-party             # all-party = never keep audio, text notes only

# ── Check-ins ────────────────────────────────────────────────────────────────────────────
# CHECKIN_TIMEOUT_S=30
# URGENT_CHECKIN_TIMEOUT_S=15
# DATA_DIR=/full/path/to/data          # where profiles, logs and clips go (default: app/data)

# ── The phone app (mobile/) ──────────────────────────────────────────────────────────────
# Expo reads mobile/.env, not this file. To pre-fill the server address in a development
# build, put this line in mobile/.env:
# EXPO_PUBLIC_SERVER_URL=192.168.1.20:8000
