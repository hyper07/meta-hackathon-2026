# Copy the lines you need into ../.env (the repo root) or ./.env. Everything is optional:
# without keys the app runs with the phrase list, fixed rules and dry-run alerts.

# Muse Spark through the Meta Model API: the Analyst, the alert writer, session summaries.
# Same names as Meta's legal-agent-workshop (META_API_KEY also works).
MODEL_API_KEY=
# MODEL_API_BASE_URL=https://api.meta.ai/v1
# MODEL_API_MODEL=muse-spark-1.3
# LLM_REASONING_EFFORT=low     # the default; higher efforts can use the whole token budget

# Jev (hosted) or Kev (local: python -m kev.serve --run jaredpalmer/kev-4b --port 8009).
# JEV_BASE_URL=http://127.0.0.1:8009
# JEV_API_KEY=
# JEV_MODEL=kev-latest
# JEV_MIN_LIFT=2.5

# Twilio: SMS and voice calls. TWILIO_FROM is your Twilio number, like +12125550123.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Email. For Gmail: smtp.gmail.com, port 587, and an app password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM=

# Listening and timing.
# WHISPER_MODEL=base            # tiny | base | small; bigger is slower and more accurate
# WHISPER_LANGUAGE=en           # empty = detect
# VOICE_THRESHOLD=0.86          # how close a voice must be to the owner's
# CHECKIN_TIMEOUT_S=30
# URGENT_CHECKIN_TIMEOUT_S=15
# RECORDING_RULE=one-party      # all-party = never keep audio, text notes only
