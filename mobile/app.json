{
  "expo": {
    "name": "Watch Me",
    "slug": "watch-me",
    "scheme": "watchme",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hyper07.watchme",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true },
        "NSLocalNetworkUsageDescription": "Watch Me talks to its server on your Wi-Fi."
      }
    },
    "android": {
      "package": "com.hyper07.watchme",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["VIBRATE"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Watch Me listens only after you say \"Watch me\", and only your voice can stop it.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "If you can't answer \"Are you OK?\", your location goes to the people you chose."
        }
      ],
      "expo-secure-store",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
